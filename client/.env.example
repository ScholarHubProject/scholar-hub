# Optional. Leave this unset for normal deployments.
#
# In production the API runs as a Netlify function on the same origin as the
# site, so the client defaults to the relative path "/api" and needs no URL.
# Local development defaults to http://127.0.0.1:5001/api.
#
# Set this only when pointing the client at an API on a different host.
# VITE_API_BASE_URL=https://your-site.netlify.app/api
