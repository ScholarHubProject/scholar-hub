# Use Railway's public MySQL URL when the backend runs on Render.
# Do not use mysql.railway.internal from Render; that host only works inside Railway.
DATABASE_URL=mysql://root:your_railway_password@your_public_proxy_host:your_public_proxy_port/railway

# Optional individual variables if you do not use DATABASE_URL:
# DB_HOST=your_public_proxy_host
# DB_PORT=your_public_proxy_port
# DB_USER=root
# DB_PASSWORD=your_railway_password
# DB_NAME=railway

# Some MySQL providers require SSL. Railway usually does not require this for the public proxy.
# DB_SSL=false
