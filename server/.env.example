# Supabase Postgres connection.
#
# Get this from: Supabase dashboard -> your project -> Connect -> ORMs / Connection string.
#
# IMPORTANT: use the *Transaction pooler* (port 6543) connection string, NOT the
# "Direct connection" one. Direct connections are IPv6-only and hold a session per
# client, which does not suit serverless functions that scale to many instances.
#
# The pooler URL looks like this (note the "pooler.supabase.com" host):
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Optional individual variables if you do not use DATABASE_URL:
# DB_HOST=aws-0-your-region.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.your_project_ref
# DB_PASSWORD=your_password
# DB_NAME=postgres

# TLS is ON by default because Supabase requires it.
# Set this to false ONLY when pointing at a plain local Postgres.
# DB_SSL=false

# ---------------------------------------------------------------------------
# Supabase Storage — holds application requirement files and profile photos.
#
# Uploads cannot be written to disk on Vercel, so every file goes to a Storage
# bucket instead. Create a bucket (default name "uploads") under
# Supabase dashboard -> Storage, then fill these in.
#
# SUPABASE_URL is the project URL from Settings -> API, e.g.
#   https://your_project_ref.supabase.co
SUPABASE_URL=https://your_project_ref.supabase.co

# The service_role key from Settings -> API. It bypasses row level security,
# so it must only ever live in server environment variables — never in client
# code and never committed.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional; defaults to "uploads".
# SUPABASE_STORAGE_BUCKET=uploads
